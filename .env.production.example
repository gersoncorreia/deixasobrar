APP_NAME=DeixaSobrar
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://deixasobrar.aljavatech.com.br

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Configuração de Banco MySQL da HostGator (Criado via cPanel > Bancos de Dados MySQL)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=usuario_deixasobrar
DB_USERNAME=usuario_deixasobrar
DB_PASSWORD=sua_senha_forte_aqui

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=mail.aljavatech.com.br
MAIL_PORT=465
MAIL_USERNAME=contato@aljavatech.com.br
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="contato@aljavatech.com.br"
MAIL_FROM_NAME="DeixaSobrar"

# Google Gemini AI (OCR de Cupons & Classificação Financeira Inteligente)
# Dica: Você também pode definir a API Key pelo Painel Master Admin (/master-admin)
GEMINI_API_KEY=

# Asaas Gateway (Cobranças PIX / Cartão)
ASAAS_ENVIRONMENT=production
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
